---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';
---

<Layout title={`${ui.nav.services} · ${ui.brand}`} description={ui.services.lead}>
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">{ui.services.kicker}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">{ui.services.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{ui.services.lead}</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-12">
    <div class="grid gap-4 md:grid-cols-2">
      {
        ui.services.groups.map((group) => (
          <article class="border border-line bg-surface p-6">
            <h2 class="text-lg font-medium tracking-tight text-ink">{group.title}</h2>
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
              {group.items.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 bg-accent"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
