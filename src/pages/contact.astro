---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';
---

<Layout title={`${ui.nav.contact} · ${ui.brand}`} description={ui.contact.lead}>
  <section class="mx-auto max-w-5xl px-5 py-16">
    <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">{ui.contact.kicker}</p>
    <h1 class="mt-3 max-w-xl text-4xl font-semibold tracking-tight text-ink">{ui.contact.title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{ui.contact.lead}</p>

    <dl class="mt-12 grid gap-8 border border-line bg-surface p-6 sm:grid-cols-2">
      <div>
        <dt class="font-mono text-xs tracking-widest text-muted uppercase">{ui.contact.emailLabel}</dt>
        <dd class="mt-2">
          <a href={`mailto:${ui.contact.email}`} class="text-xl text-accent hover:underline">
            {ui.contact.email}
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-mono text-xs tracking-widest text-muted uppercase">{ui.contact.phoneLabel}</dt>
        <dd class="mt-2">
          <a href={`tel:${ui.contact.phoneHref}`} class="text-xl text-accent hover:underline">
            {ui.contact.phone}
          </a>
        </dd>
      </div>
    </dl>
  </section>
</Layout>
